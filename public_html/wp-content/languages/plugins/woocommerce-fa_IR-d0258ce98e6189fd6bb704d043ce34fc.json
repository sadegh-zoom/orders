{"translation-revision-date":"2026-08-21 13:17:38+0000","generator":"GlotPress\/4.1.0","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","plural-forms":"nplurals=2; plural=n > 1;","lang":"fa"},"Sample products shown for preview. Actual products will be based on store inventory.":["\u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0646\u0645\u0648\u0646\u0647 \u0628\u0631\u0627\u06cc \u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0648\u0627\u0642\u0639\u06cc \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0648\u062c\u0648\u062f\u06cc \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u062e\u0648\u0627\u0647\u0646\u062f \u0628\u0648\u062f."],"Select taxonomy terms to display products from.":["\u0627\u0635\u0637\u0644\u0627\u062d\u0627\u062a taxonomy \u0631\u0627 \u0628\u0631\u0627\u06cc \u0646\u0645\u0627\u06cc\u0634 \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0627\u0632 \u0622\u0646\u200c\u0647\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f."],"Select products to display in this collection.":["\u0645\u062d\u0635\u0648\u0644\u0627\u062a\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0646\u0645\u0627\u06cc\u0634 \u062f\u0631 \u0627\u06cc\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f."],"Number of products":["\u062a\u0639\u062f\u0627\u062f \u0645\u062d\u0635\u0648\u0644\u0627\u062a"],"All selected brands":["\u0647\u0645\u0647 \u0628\u0631\u0646\u062f\u0647\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647"],"Any selected brands":["\u0647\u0631 \u0628\u0631\u0646\u062f \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647"],"Pick at least two brands to use this setting.":["\u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u062a\u0646\u0638\u06cc\u0645 \u062d\u062f\u